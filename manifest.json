{
  "manifest_version": 3,
  "version": "2.0.0",
  "author": "NDM Plus contributors",
  "description": "Unofficial extension for Neat Download Manager",
  "name": "NDM Plus",
  "action": {
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "js": [
        "i18n.js",
        "capture-policy.js",
        "ct.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "webRequest",
    "webNavigation",
    "cookies",
    "contextMenus",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "img/icon128.png",
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png"
  },
  "homepage_url": "https://github.com/umlearn/ndm-plus",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
